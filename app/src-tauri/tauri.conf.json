{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studiolo",
  "version": "0.1.0",
  "identifier": "io.github.jadonjahn.studiolo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Studiolo",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#07070f"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Focus timer with generative art"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMjZERDg3NjY5REFDMjEKUldRaHJKMW1oOTBtWEJPbnhzS2QrNWRHL0FmYW1uRjZyUlVxdVhwK1BDcVpQOHU2VWRyZ3VoTVAK",
      "endpoints": [
        "https://github.com/jadonJahn/studiolo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
